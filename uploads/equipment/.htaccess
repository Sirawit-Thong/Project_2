# ป้องกันการ execute PHP/CGI ในโฟลเดอร์ uploads
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} \.(php|php3|php4|php5|phtml|pl|py|cgi|sh|asp|aspx|jsp)$ [NC]
    RewriteRule ^ - [F,L]
</IfModule>

# ป้องกัน directory listing
Options -Indexes

# ปิดการ execute script (.php) ผ่าน handler อื่น
<IfModule mod_php.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .phps .phar
    RemoveType .php .phtml .php3 .php4 .php5 .phps .phar
</IfModule>

# อนุญาตเฉพาะไฟล์ static ที่กำหนดไว้เท่านั้น — ไฟล์อื่น (รวม .php, .txt, .html, .svg ฯลฯ) ถูก DENY หมด
<FilesMatch "\.(?!(jpg|jpeg|png|gif|webp|pdf|doc|docx|xls|xlsx)$)[^.]+$">
    Require all denied
</FilesMatch>
