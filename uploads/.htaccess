# ป้องกันการ execute PHP/CGI ในโฟลเดอร์ uploads
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} \.(php|php3|php4|php5|phtml|pl|py|cgi|sh)$ [NC]
    RewriteRule ^ - [F,L]
</IfModule>

# ป้องกัน directory listing
Options -Indexes

# ป้องกันการเข้าถึงไฟล์โดยตรง ( ALLOW เฉพาะ static files)
<FilesMatch "\.(?i:jpg|jpeg|png|gif|webp|pdf|doc|docx|xls|xlsx)$">
    # อนุญาตให้เข้าถึงได้
</FilesMatch>
