# OS / Editor
Thumbs.db
Desktop.ini
.DS_Store
*.log

# Uploads — กันไฟล์รูปขึ้น repo แต่เก็บ .htaccess ไว้
uploads/equipment/*
uploads/repairs/*
!uploads/equipment/.htaccess
!uploads/repairs/.htaccess

# ไฟล์ตั้งค่าที่เป็นความลับ
.env
config/*.local.php
docs/*
!docs/BACKUP.md

# Backups — กันไฟล์สำรองขึ้น repo แต่เก็บโครงสร้างโฟลเดอร์ไว้
backups/*
!backups/.htaccess
!backups/README.md
*.sql.gz
